<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.daxiong.infinitecanvas.bridge"
    ExtensionBundleVersion="0.2.7"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <ExtensionList>
        <Extension Id="com.daxiong.infinitecanvas.bridge.panel" Version="0.2.7"/>
    </ExtensionList>
    <ExecutionEnvironment>
        <HostList>
            <Host Name="PHSP" Version="[19.0,99.9]"/>
            <Host Name="PHXS" Version="[19.0,99.9]"/>
        </HostList>
        <LocaleList>
            <Locale Code="All"/>
        </LocaleList>
        <RequiredRuntimeList>
            <RequiredRuntime Name="CSXS" Version="7.0"/>
        </RequiredRuntimeList>
    </ExecutionEnvironment>
    <DispatchInfoList>
        <Extension Id="com.daxiong.infinitecanvas.bridge.panel">
            <DispatchInfo>
                <Resources>
                    <MainPath>./client/index.html</MainPath>
                    <ScriptPath>./host/index.jsx</ScriptPath>
                    <CEFCommandLine>
                        <Parameter>--enable-nodejs</Parameter>
                        <Parameter>--mixed-context</Parameter>
                    </CEFCommandLine>
                </Resources>
                <Lifecycle>
                    <AutoVisible>true</AutoVisible>
                </Lifecycle>
                <UI>
                    <Type>Panel</Type>
                    <Menu>Infinite Canvas Bridge</Menu>
                    <Geometry>
                        <Size>
                            <Width>360</Width>
                            <Height>540</Height>
                        </Size>
                        <MinSize>
                            <Width>300</Width>
                            <Height>420</Height>
                        </MinSize>
                        <MaxSize>
                            <Width>1600</Width>
                            <Height>1600</Height>
                        </MaxSize>
                    </Geometry>
                    <Icons>
                        <Icon Type="Normal">./icons/canvas-light.png</Icon>
                        <Icon Type="RollOver">./icons/canvas-light.png</Icon>
                        <Icon Type="DarkNormal">./icons/canvas-dark.png</Icon>
                        <Icon Type="DarkRollOver">./icons/canvas-dark.png</Icon>
                    </Icons>
                </UI>
            </DispatchInfo>
        </Extension>
    </DispatchInfoList>
</ExtensionManifest>
