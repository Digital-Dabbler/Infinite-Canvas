{
  "_comment": "Shared corpus for the smart-note rich text whitelist. Both sanitizeNoteRichText() (static/js/smart-canvas.js) and sanitize_note_richtext() (main.py) must produce `expected` for `input`; a single case keeps the two implementations from drifting. tag/attribute order is part of the contract: keep one data-* attribute per tag so the two serialisers cannot disagree on order.",
  "cases": [
    { "name": "plain text is passed through", "input": "hello 便签 world", "expected": "hello 便签 world" },
    { "name": "legacy b/i/strike aliases normalise", "input": "<b>bold</b><i>it</i><strike>s</strike><del>d</del>", "expected": "<strong>bold</strong><em>it</em><s>s</s><s>d</s>" },
    { "name": "script loses its content", "input": "a<script>alert(1)</script>b", "expected": "ab" },
    { "name": "style loses its content", "input": "a<style>p{color:red}</style>b", "expected": "ab" },
    { "name": "iframe loses its content", "input": "<iframe src=\"x\"></iframe>ok", "expected": "ok" },
    { "name": "svg subtree is dropped", "input": "<svg><circle /></svg>after", "expected": "after" },
    { "name": "img is unwrapped and contributes nothing", "input": "x<img src=y onerror=\"alert(1)\">y", "expected": "xy" },
    { "name": "unknown block tag is unwrapped, text survives", "input": "<p>para</p>", "expected": "para" },
    { "name": "div is unwrapped, br survives", "input": "<div>a<br>b</div>", "expected": "a<br>b" },
    { "name": "ul/ol/li survive", "input": "<ol><li>a</li><li>b</li></ol>", "expected": "<ol><li>a</li><li>b</li></ol>" },
    { "name": "h1-h3 survive", "input": "<h1>t</h1><h2>u</h2><h3>v</h3>", "expected": "<h1>t</h1><h2>u</h2><h3>v</h3>" },
    { "name": "https link survives", "input": "<a href=\"https://example.com/x\">go</a>", "expected": "<a href=\"https://example.com/x\">go</a>" },
    { "name": "mailto link survives", "input": "<a href=\"mailto:a@b.com\">m</a>", "expected": "<a href=\"mailto:a@b.com\">m</a>" },
    { "name": "site relative link survives", "input": "<a href=\"/notes/1\">n</a>", "expected": "<a href=\"/notes/1\">n</a>" },
    { "name": "javascript link loses only the href", "input": "<a href=\"javascript:alert(1)\">x</a>", "expected": "<a>x</a>" },
    { "name": "protocol relative link is rejected", "input": "<a href=\"//evil.example\">x</a>", "expected": "<a>x</a>" },
    { "name": "onclick is dropped, href kept", "input": "<a href=\"https://e.com\" onclick=\"steal()\">y</a>", "expected": "<a href=\"https://e.com\">y</a>" },
    { "name": "target and rel are dropped with the link kept", "input": "<a href=\"https://e.com\" target=\"_blank\" rel=\"noopener\">y</a>", "expected": "<a href=\"https://e.com\">y</a>" },
    { "name": "entities in an href are decoded once, not double escaped", "input": "<a href=\"https://e.com/?a=1&amp;b=2\">q</a>", "expected": "<a href=\"https://e.com/?a=1&amp;b=2\">q</a>" },
    { "name": "style attribute is dropped", "input": "<strong style=\"color:red\">t</strong>", "expected": "<strong>t</strong>" },
    { "name": "class attribute is dropped", "input": "<strong class=\"x\" data-whatever=\"1\">t</strong>", "expected": "<strong>t</strong>" },
    { "name": "data-fs survives on a block tag", "input": "<h1 data-fs=\"3\">t</h1>", "expected": "<h1 data-fs=\"3\">t</h1>" },
    { "name": "data-fs out of range is dropped", "input": "<h1 data-fs=\"9\">t</h1>", "expected": "<h1>t</h1>" },
    { "name": "data-fs is rejected on an inline tag", "input": "<strong data-fs=\"2\">t</strong>", "expected": "<strong>t</strong>" },
    { "name": "data-align survives on a list item", "input": "<ul><li data-align=\"center\">a</li></ul>", "expected": "<ul><li data-align=\"center\">a</li></ul>" },
    { "name": "data-align out of range is dropped", "input": "<h2 data-align=\"justify\">t</h2>", "expected": "<h2>t</h2>" },
    { "name": "data-checked survives", "input": "<ul><li data-checked=\"true\">a</li></ul>", "expected": "<ul><li data-checked=\"true\">a</li></ul>" },
    { "name": "data-checked normalises truthy spellings", "input": "<ul><li data-checked=\"yes\">a</li></ul>", "expected": "<ul><li data-checked=\"true\">a</li></ul>" },
    { "name": "data-checked normalises falsey spellings", "input": "<ul><li data-checked=\"0\">a</li></ul>", "expected": "<ul><li data-checked=\"false\">a</li></ul>" },
    { "name": "unclosed inline tag is closed for us", "input": "<strong>a", "expected": "<strong>a</strong>" },
    { "name": "stray closing tag is dropped", "input": "</em>text", "expected": "text" },
    { "name": "misnested tags still produce well formed html", "input": "<strong><em>x</strong>y", "expected": "<strong><em>x</em></strong>y" },
    { "name": "same tag nested keeps its depth", "input": "<strong>a<strong>b</strong>c</strong>", "expected": "<strong>a<strong>b</strong>c</strong>" },
    { "name": "literal angle brackets in text are escaped", "input": "1 < 2 > 0", "expected": "1 &lt; 2 &gt; 0" },
    { "name": "text entities are left for the browser to decode", "input": "a &amp; b &#39;c&#39;", "expected": "a &amp; b &#39;c&#39;" },
    { "name": "comment is dropped", "input": "a<!-- x -->b", "expected": "ab" },
    { "name": "cdata is dropped", "input": "a<![CDATA[x]]>b", "expected": "ab" },
    { "name": "doctype is dropped", "input": "<!DOCTYPE html>x", "expected": "x" },
    { "name": "empty input stays empty", "input": "", "expected": "" },
    { "name": "tag with uppercase name is normalised", "input": "<STRONG>A</STRONG>", "expected": "<strong>A</strong>" }
  ]
}
